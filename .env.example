# ============================================================
# MT5 Trading App — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ------ Application ------
APP_ENV=development         # development | staging | production
APP_NAME="MT5 Trade Monitor"
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://192.168.1.x:8081

# ------ Database ------
DATABASE_URL=postgresql+asyncpg://mt5user:mt5pass@localhost:5432/mt5db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------ Redis ------
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# ------ Auth / JWT ------
JWT_SECRET_KEY=change-me-to-another-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ------ MT5 EA Auth ------
EA_API_KEY_PREFIX=mt5ea_
EA_RATE_LIMIT_PER_MINUTE=120

# ------ Push Notifications (Expo) ------
EXPO_ACCESS_TOKEN=your-expo-access-token-here

# ------ Risk Defaults ------
DEFAULT_DAILY_RISK_LIMIT_PCT=5.0
DEFAULT_MAX_DRAWDOWN_PCT=10.0
DEFAULT_RISK_PER_TRADE_PCT=1.0

# ------ EA Health ------
EA_HEARTBEAT_TIMEOUT_SECONDS=60
EA_OFFLINE_ALERT_AFTER_SECONDS=120

# ------ Demo Mode ------
DEMO_MODE=true
SEED_DEMO_DATA=true

# ------ Logging ------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------ CORS ------
CORS_ALLOW_ALL=false
